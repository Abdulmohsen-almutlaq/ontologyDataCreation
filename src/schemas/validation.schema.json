{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SemanticValidation",
  "type": "object",
  "required": [
    "consistent"
  ],
  "properties": {
    "consistent": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "message"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}

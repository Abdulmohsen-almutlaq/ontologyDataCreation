              "ADD_ATTRIBUTE",
              "UPDATE_ATTRIBUTE",
              "ADD_RELATIONSHIP",
              "UPDATE_RELATIONSHIP",
              "ADD_CONCEPT",
              "ADD_METRIC",
              "ADD_EVENT",
              "ADD_RULE",
              "MERGE_CONCEPT",
              "MARK_UNCERTAIN",
              "REQUEST_OBSERVATION"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "entity": {
            "type": "string"
          },
          "attribute": {},
          "target": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "cardinality": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "basedOn": {
            "type": "array",

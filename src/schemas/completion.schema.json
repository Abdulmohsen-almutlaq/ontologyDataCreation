{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompletionAssessment",
  "type": "object",
  "required": [
    "sufficient"
  ],
  "properties": {
    "sufficient": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string"
    },
    "remainingRisks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

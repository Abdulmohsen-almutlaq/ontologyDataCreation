{
  "name": "ontology-harness",
  "version": "1.0.0",
  "private": true,
  "description": "Adaptive agentic ontology generation harness",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build:tests && node --test dist-tests/tests/*.test.js",
    "build:tests": "tsc -p tsconfig.tests.json",
    "cli": "node dist/index.js --interactive"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "typescript": "^5.5.4"
  }
}

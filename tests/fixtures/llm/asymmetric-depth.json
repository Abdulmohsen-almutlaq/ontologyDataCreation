    {
      "label": "gap-analysis",
      "response": {
        "gaps": [
          {
            "type": "AMBIGUOUS_CONCEPT",
            "target": "order",
            "severity": "high",
            "reason": "orders.total_amount is a raw column: cancelled orders, refunds and three currencies are all unmodelled, so any revenue figure taken from it is wrong."
          }
        ]
      }
    },
    {
      "label": "depth-decision",
      "response": {
        "decision": "GO_DEEPER",
        "targetDepth": 5,
        "targetNodes": [
          "order"
        ],
        "reason": "Revenue is not defined. total_amount mixes cancelled orders and three currencies, and refunds are recorded separately, so the business meaning must be modelled explicitly. Customer and Product are already sufficiently understood and are deliberately left alone.",
        "expectedValue": 0.93,
        "expectedInformationGain": 0.87,
        "uncertainty": 0.71,
        "complexityCost": 0.24,
        "nextFocus": [
          "refunds",
          "order_status",
          "currency"
        ],
        "requiredEvidence": [
          {
            "target": "orders.status",
            "observationType": "value_distribution",
            "reason": "Find out which order states exist and how much volume cancellations carry."
          },
          {
            "target": "orders.currency",
            "observationType": "value_distribution",
            "reason": "Determine whether amounts are single-currency."
          }
        ]
      }
    },
    {
      "label": "concept-discovery",
      "response": {
        "reasoning": "Revenue is a business concept spanning orders and refunds; net revenue is the metric that makes its exclusions explicit.",
        "confidence": 0.86,
        "operations": [
          {
            "type": "ADD_CONCEPT",
            "name": "Revenue",
            "description": "Value earned from completed orders. Excludes cancelled orders; stated per order currency, not converted.",
            "basedOn": [
              "order"
            ],
            "status": "INFERRED",
            "confidence": 0.84,
            "evidence": [
              {
                "locator": "orders.total_amount",
                "summary": "amount column",
                "status": "OBSERVED"
              },
              {
                "locator": "orders.status",
                "summary": "4.8% of orders are cancelled",
                "status": "OBSERVED"
              },
              {
                "locator": "orders.currency",
                "summary": "three currencies present, no conversion column",
                "status": "OBSERVED"
              }
            ],
            "source": [
              {
                "locator": "postgres:public.orders",
                "kind": "table"
              }
            ]
          },
          {
            "type": "ADD_METRIC",
            "name": "Net Revenue",
            "description": "Revenue after refunds.",
            "definition": "sum(orders.total_amount WHERE status <> 'cancelled') - sum(refunds.amount), per currency",
            "unit": "currency",
            "basedOn": [
              "revenue"
            ],
            "status": "DERIVED",
            "confidence": 0.78,
            "evidence": [
              {
                "locator": "refunds.amount",
                "summary": "refunds table records 260 rows against orders",
                "status": "OBSERVED"
              }
            ],
            "source": [
              {
                "locator": "postgres:public.refunds",
                "kind": "table"
              }
            ]
          },
          {
            "type": "MARK_UNCERTAIN",
            "target": "Net Revenue",
            "reason": "Whether partial refunds are recorded as separate rows was never confirmed."
          }
        ]
      }
    },

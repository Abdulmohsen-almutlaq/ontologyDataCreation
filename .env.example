# Copy to .env and fill in.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------- data source ----------
# DATABASE_URL's scheme picks the driver (postgresql://, redshift://, ...).
# Run `sources` in the interactive shell for the full list.
SOURCE_KIND=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ontology
SOURCE_SCHEMA=public
OBSERVATION_FIXTURE_DIR=./tests/fixtures/observation
# Free-text hint of what the schema is expected to contain - a steer for
# discovery, not a fact; it still verifies everything against the live
# observations. See prompts/v1/ontology/expected-schema.md. Unset by default.
# EXPECTED_SCHEMA=a customers table, an orders table, and a products table

# ---------- llm ----------
# ollama | openai-compatible | deepseek | mock
#
#   ollama:            LLM_MODEL=qwen3:8b            LLM_BASE_URL=http://host.docker.internal:11434
#   openai-compatible: LLM_MODEL=<model>              LLM_BASE_URL=http://localhost:8000/v1   LLM_API_KEY=local
#   deepseek:          LLM_MODEL=deepseek-v4-flash    LLM_API_KEY=sk-...   (LLM_BASE_URL not needed)
#   mock:              LLM_MODEL=scripted             LLM_MOCK_SCRIPT=./tests/fixtures/llm/asymmetric-depth.json
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODELS=deepseek-v4-flash-vision-exp
DEEPSEEK_MAX_CONTEXT_TOKENS=1000000

LLM_TEMPERATURE=0
# Every call is structural (typed operations, enum decisions) except the
# completion-summary prose. Unset by default - no behaviour change. Raises
# only that one call:
# LLM_COMPLETION_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_MS=120000
LLM_MAX_CORRECTION_RETRIES=2
LLM_MOCK_SCRIPT=./tests/fixtures/llm/basic.json
# Force stricter structured output; downgrades to json_object automatically if rejected.
# LLM_CAP_JSON_SCHEMA=true

# ---------- prompts ----------
PROMPTS_DIR=./prompts
PROMPT_VERSION=v1

# ---------- limits ----------
ONTOLOGY_MAX_DEPTH=10
ONTOLOGY_MAX_ITERATIONS=25
ONTOLOGY_MAX_LLM_CALLS=100
ONTOLOGY_MAX_NODES=1000
ONTOLOGY_MAX_OBSERVATION_REQUESTS=200
ONTOLOGY_MAX_RUNTIME_MS=900000

# ---------- output ----------
OUTPUT_DIR=./out
TRACE_ENABLED=true

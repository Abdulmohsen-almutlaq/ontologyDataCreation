# ---------- runtime ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------- data source ----------
# postgres | fixture
SOURCE_KIND=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ontology
SOURCE_SCHEMA=public
# used only when SOURCE_KIND=fixture
OBSERVATION_FIXTURE_DIR=./tests/fixtures/observation

# ---------- llm ----------
# ollama | openai-compatible | mock
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_MS=120000
LLM_MAX_CORRECTION_RETRIES=2
# Optional capability overrides (true/false). Leave unset to use provider defaults.
# LLM_CAP_STRUCTURED_OUTPUT=true
# LLM_CAP_JSON_SCHEMA=true
# LLM_CAP_TOOL_CALLING=false
# LLM_CAP_STREAMING=true
# LLM_CAP_VISION=false
# LLM_CAP_MAX_CONTEXT_TOKENS=32768
# used only when LLM_PROVIDER=mock
LLM_MOCK_SCRIPT=./tests/fixtures/llm/basic.json

# ---------- prompts ----------
PROMPTS_DIR=./prompts
PROMPT_VERSION=v1

# ---------- exploration limits ----------
ONTOLOGY_MAX_DEPTH=10
ONTOLOGY_MAX_ITERATIONS=25
ONTOLOGY_MAX_LLM_CALLS=100
ONTOLOGY_MAX_NODES=1000
ONTOLOGY_MAX_OBSERVATION_REQUESTS=200
ONTOLOGY_MAX_RUNTIME_MS=900000

# ---------- output ----------
OUTPUT_DIR=./out
TRACE_ENABLED=true
